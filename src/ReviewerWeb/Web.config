<?xml version="1.0"?>
<configuration>
  <system.web>
    <compilation debug="false" strict="true" explicit="true" targetFramework="4.8.1" />
    <httpRuntime targetFramework="4.8.1" requestValidationMode="4.5" maxRequestLength="64" enableVersionHeader="false" />
    <globalization requestEncoding="utf-8" responseEncoding="utf-8" fileEncoding="utf-8" />
    <httpCookies httpOnlyCookies="true" sameSite="Lax" requireSSL="false" />
    <pages validateRequest="true" enableEventValidation="true" viewStateEncryptionMode="Always" />
    <sessionState mode="InProc" timeout="30" cookieSameSite="Lax" />
    <customErrors mode="On" defaultRedirect="dev-login.aspx" />
  </system.web>
  <system.webServer>
    <defaultDocument enabled="true"><files><clear /><add value="dev-login.aspx" /></files></defaultDocument>
    <httpProtocol>
      <customHeaders>
        <add name="Cache-Control" value="no-store, max-age=0" />
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="X-Frame-Options" value="DENY" />
        <add name="Referrer-Policy" value="no-referrer" />
      </customHeaders>
    </httpProtocol>
  </system.webServer>
</configuration>
